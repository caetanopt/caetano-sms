generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

enum ConsentStatus {
  UNKNOWN
  OPTED_IN
  OPTED_OUT
}

enum MessageType {
  TRANSACTIONAL
  PROMOTIONAL
}

enum SmsMessageStatus {
  PENDING
  ACCEPTED
  QUEUED
  SENT
  DELIVERED
  FAILED
  UNROUTABLE
  PROTECT_BLOCKED
  UNKNOWN
  CANCELLED
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  role         UserRole     @default(OPERATOR)
  isActive     Boolean      @default(true)
  messages     SmsMessage[]
  auditLogs    AuditLog[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Contact {
  id            String        @id @default(cuid())
  name          String
  phoneE164     String        @unique
  email         String?
  consentStatus ConsentStatus @default(UNKNOWN)
  consentAt     DateTime?
  consentSource String?
  optedOutAt    DateTime?
  notes         String?
  messages      SmsMessage[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model SmsMessage {
  id                    String           @id @default(cuid())
  idempotencyKey        String           @unique
  awsMessageId          String?          @unique
  contactId             String?
  contact               Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  destinationPhoneE164  String
  messageType           MessageType
  body                  String
  encodingEstimate      String?
  segmentCountEstimate  Int?
  status                SmsMessageStatus @default(PENDING)
  provider              String
  errorCode             String?
  errorMessage          String?
  sentAt                DateTime?
  deliveredAt           DateTime?
  failedAt              DateTime?
  createdById           String
  createdBy             User             @relation(fields: [createdById], references: [id])
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([createdAt])
  @@index([status])
  @@index([destinationPhoneE164])
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String
  entityType   String
  entityId     String?
  metadataJson Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}
