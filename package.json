{
  "name": "sms-aws-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker:campaigns": "tsx scripts/campaign-worker.ts",
    "worker:sms-jobs": "tsx scripts/sms-job-worker.ts",
    "retention": "tsx scripts/retention.ts",
    "aws:provision": "tsx scripts/aws-provision.ts",
    "brand:icons": "tsx scripts/brand-icons.ts",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "prisma generate && vitest run --config vitest.integration.config.ts",
    "test:e2e": "pnpm build && playwright test",
    "validate": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "audit:deps": "pnpm audit && tsx scripts/check-audit-ignores.ts",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-pinpoint-sms-voice-v2": "^3.0.0",
    "@aws-sdk/client-sqs": "^3.1141.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "libphonenumber-js": "^1.12.0",
    "next": "^16.3.8",
    "pg": "^8.16.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1142.0",
    "@aws-sdk/client-sns": "^3.1142.0",
    "@aws-sdk/client-sts": "^3.1142.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^18.0.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.8",
    "jsqr": "^1.4.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
