# Application
NODE_ENV=development
APP_URL=http://localhost:3000
# Mínimo 32 caracteres. Gerar, por exemplo, com: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-random-string-with-at-least-32-chars

# Utilizador administrador criado por `pnpm db:seed`
ADMIN_EMAIL=admin@example.com
# Mínimo 12 caracteres
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=Administrador
# Só para recuperação: "true" repõe também o 2FA do administrador ao correr o seed.
ADMIN_RESET_MFA=false

# 2FA (TOTP). Obrigatório para ADMIN; "false" apenas em desenvolvimento/testes automáticos.
MFA_REQUIRED_FOR_ADMINS=true
# Nome mostrado na app de autenticação
MFA_ISSUER=SMS AWS
# Chave de cifra dos segredos TOTP (mín. 32 caracteres). Vazio = derivada de AUTH_SECRET.
# Mudar esta chave (ou AUTH_SECRET sem ela) obriga a reconfigurar o 2FA de todos.
MFA_ENCRYPTION_KEY=

# Database (coincide com docker-compose.yml)
DATABASE_URL=postgresql://smsapp:smsapp@localhost:5432/sms_app
# Base de dados separada para `pnpm test:integration` (os testes apagam dados)
TEST_DATABASE_URL=postgresql://smsapp:smsapp@localhost:5432/sms_app_test

# SMS provider: fake (desenvolvimento, sem chamadas AWS) | aws
SMS_PROVIDER=fake
# Apenas provider fake: success | failure | throttle | opt_out | uncertain | auth | spend_limit
SMS_FAKE_SCENARIO=success
# Latência simulada do provider fake (0-30000 ms)
SMS_FAKE_DELAY_MS=0

# AWS
AWS_REGION=eu-west-1
AWS_SMS_ORIGINATION_IDENTITY=
AWS_SMS_CONFIGURATION_SET=
AWS_SMS_PROTECT_CONFIGURATION_ID=
# Eventos de entrega (Configuration Set → SNS → POST /api/webhooks/aws-sms-events).
# ARN(s) do tópico SNS autorizado, separados por vírgula. Vazio = endpoint desativado (404).
AWS_SMS_EVENTS_SNS_TOPIC_ARN=
AWS_SMS_DEFAULT_MESSAGE_TYPE=TRANSACTIONAL
# Qualquer valor diferente de "false" mantém o modo de teste.
AWS_SMS_DRY_RUN=true

# Apenas desenvolvimento local, se necessário.
# Em produção usar IAM Role / workload identity e NÃO access keys estáticas.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Fila de jobs de envio: direct (defeito, envio dentro do passo) | sqs (pnpm worker:sms-jobs)
SMS_JOB_QUEUE=direct
# Só com SMS_JOB_QUEUE=sqs; a fila tem de estar em AWS_REGION (ver docs/AWS_SETUP.md §12)
AWS_SQS_SMS_JOBS_QUEUE_URL=
# DLQ (opcional), só para a métrica de profundidade
AWS_SQS_SMS_JOBS_DLQ_URL=
SMS_SQS_MAX_IN_FLIGHT=10
SMS_SQS_VISIBILITY_TIMEOUT_SECONDS=60

# Safety limits
SMS_MAX_RECIPIENTS_PER_CAMPAIGN=500
# Global (campanhas + envio individual). Cada campanha pode definir um ritmo inferior no rascunho.
SMS_MAX_SENDS_PER_MINUTE=60
# Quota diária de partes SMS por utilizador (envio individual + campanhas que confirmou),
# dia civil Europe/Lisbon, inclui envios em modo de teste. Override por utilizador em /users/[id]
# (0 = sem envios). Mínimo 1: não existe "ilimitado" — configurar um valor alto explicitamente.
SMS_USER_DAILY_PARTS_LIMIT=2000
# Partes SMS por segundo (MPS): configurar ao nível ou abaixo dos valores da conta AWS.
# Total da identidade de origem:
SMS_MPS_PER_ORIGIN=1
# Por país de destino (ISO 3166-1 alfa-2), ex.: PT=5,ES=1
SMS_MPS_BY_COUNTRY=PT=1
# Países sem valor explícito:
SMS_MPS_COUNTRY_DEFAULT=1
# Rajada permitida: capacidade do balde = MPS × segundos
SMS_MPS_BURST_SECONDS=1
# Mensagens processadas por passo de campanha (cada passo é um pedido curto)
SMS_CAMPAIGN_BATCH_SIZE=10
# Acima deste número de destinatários é pedida a confirmação textual "ENVIAR N SMS"
SMS_BULK_CONFIRMATION_THRESHOLD=50
# Tentativas por destinatário, só para falhas garantidamente não enviadas (ex.: throttling)
SMS_CAMPAIGN_MAX_ATTEMPTS=3

# Retenção (dias) — validar com o DPO. `pnpm retention` simula; `--apply` aplica.
SMS_RETENTION_DAYS=365
DELIVERY_EVENT_RETENTION_DAYS=365
LOGIN_ATTEMPT_RETENTION_DAYS=30
AUDIT_IP_RETENTION_DAYS=90

# Só com proxy/load balancer de confiança à frente: usa X-Forwarded-For para o IP do cliente.
TRUST_PROXY=false

# Observabilidade (ver README): vazio = GET /api/metrics desativado (404). Mínimo 32 caracteres.
METRICS_TOKEN=
# Snapshot CloudWatch EMF (linha JSON no stdout) em pnpm worker:campaigns
METRICS_EMF=false
METRICS_EMF_INTERVAL_SECONDS=60
METRICS_EMF_NAMESPACE=SmsApp
